{
    "name": "oki-technologies/people-php",
    "description": "Sign people in with People, verify their tokens and keep their identities current.",
    "keywords": [
        "oauth2",
        "openid-connect",
        "oidc",
        "jwt",
        "jwks",
        "pkce",
        "identity"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lcobucci/jwt": "^5.3",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Oki\\People\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oki\\People\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest --coverage --min=100",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
